; Classic turtle graphics programs from jsLogo examples

to star
  repeat 5 [ fd 100 rt 144 ]
end

to square :length
  repeat 4 [ fd :length rt 90 ]
end

to triangle :length
  repeat 3 [ fd :length rt 120 ]
end

to polygon :sides :length
  repeat :sides [ fd :length rt 360 / :sides ]
end

to circle :radius
  repeat 360 [ fd :radius * 2 * 3.14159 / 360 rt 1 ]
end

to spiral :step :angle :count
  repeat :count [
    fd :step
    rt :angle
    make "step :step + 2
  ]
end

to tree :size
  if :size < 5 [ forward :size back :size stop ]
  forward :size / 3
  left 30 tree :size * 2 / 3 right 30
  forward :size / 6
  right 25 tree :size / 2 left 25
  forward :size / 3
  right 25 tree :size / 2 left 25
  forward :size / 6
  back :size
end

to fern :size :sign
  if :size < 1 [ stop ]
  fd :size
  rt 70 * :sign fern :size * 0.5 :sign * -1 lt 70 * :sign
  fd :size
  lt 70 * :sign fern :size * 0.5 :sign rt 70 * :sign
  rt 7 * :sign fern :size - 1 :sign lt 7 * :sign
  bk :size * 2
end

; Run the demos
clearscreen
star

clearscreen
repeat 36 [ square 100 rt 10 ]

clearscreen
tree 150

window clearscreen pu bk 150 pd
fern 25 1
